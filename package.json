{
  "name": "@ts-helpers/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx build --no-cloud",
    "format": "prettier --write ./packages/**/*.{ts,tsx,json,md,mdx}",
    "lint": "eslint --fix",
    "ci": "npx nx affected -t lint test build --no-cloud",
    "test": "nx test --runInBand --no-cloud --i",
    "test:all": "nx run-many -t test --coverage --no-cloud",
    "prepare": "husky",
    "postinstall": "pnpm run prepare"
  },
  "private": true,
  "dependencies": {
    "@typescript-eslint/types": "^8.19.0",
    "jest": "^29.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@nx/js": "21.1.2",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@typescript-eslint/eslint-plugin": "7.16.0",
    "@typescript-eslint/parser": "7.16.0",
    "@typescript-eslint/types": "^8.19.0",
    "@typescript-eslint/utils": "7.16.0",
    "@xrdev_38/commitlint-config": "^1.1.0",
    "@xrdev_38/eslint-config": "^1.1.0",
    "@xrdev_38/prettier-config": "^1.1.0",
    "devmoji": "^2.3.0",
    "eslint": "~8.57.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-cypress": "^2.13.4",
    "eslint-plugin-prettier": "^5.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.7",
    "nx": "21.1.2",
    "prettier": "^2.6.2",
    "tslib": "^2.3.0",
    "typescript": "~5.7.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
