{
  "name": "@xrdev_38/root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "npx lerna run lint",
    "test": "npx lerna run test",
    "test:coverage": "lerna run test:coverage",
    "build": "npx lerna run build",
    "commit": "cz",
    "version": "npx conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md && git commit -m \"chore(changelog): update changelog\"",
    "version:prerelease": "npx lerna version --yes --conventional-commits --conventional-prerelease --preid beta --yes",
    "version:ci": "npx lerna version --yes --conventional-commits --message 'chore(release): publish'",
    "bootstrap:ci": "yarn install --immutable",
    "ci": "yarn run lint & yarn run test & yarn run build",
    "build:doc": "npx lerna run --scope=@xrdev_38/ts-service-docs build",
    "publish:ci": "npx lerna publish from-package --yes --no-verify-access",
    "prepare": "husky install",
    "postinstall": "pnpm run prepare"
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.0",
    "@types/jest": "^29.4.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "6.9.1",
    "@typescript-eslint/parser": "6.9.1",
    "@xrdev_38/commitlint-config": "^1.1.0",
    "@xrdev_38/eslint-config": "^1.1.0",
    "@xrdev_38/jest-config": "^1.1.0",
    "@xrdev_38/prettier-config": "^1.1.0",
    "commitizen": "^4.3.0",
    "conventional-changelog": "^5.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "devmoji": "^2.3.0",
    "eslint": "^9.28.0",
    "husky": "^8.0.1",
    "jest": "^29.4.1",
    "jest-environment-jsdom": "^29.4.1",
    "jest-environment-node": "^29.4.1",
    "lerna": "^7.1.4",
    "prettier": "^2.6.2",
    "surge": "^0.23.1",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "typedoc": "^0.25.3",
    "typedoc-plugin-markdown": "^3.17.1",
    "typescript": "^5.4.2",
    "verdaccio": "^6.0.0"
  },
  "dependencies": {
    "tslib": "^2.6.2",
    "winston": "^3.17.0"
  }
}
