{
  "name": "@ts-helpers/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx build --no-cloud",
    "format": "prettier --write ./packages/**/*.{ts,tsx,json,md,mdx}",
    "ci": "npx nx affected -t lint test build --no-cloud",
    "test": "nx test --runInBand --no-cloud --i",
    "test:all": "nx run-many -t test --coverage --no-cloud",
    "prepare": "husky",
    "postinstall": "pnpm run prepare"
  },
  "private": true,
  "dependencies": {
    "jest": "^29.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@nx/jest": "21.1.2",
    "@nx/js": "21.1.2",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@swc/jest": "~0.2.36",
    "@types/jest": "^29.5.12",
    "@types/node": "18.16.9",
    "@xrdev_38/commitlint-config": "^1.1.0",
    "@xrdev_38/eslint-config": "^1.1.0",
    "@xrdev_38/prettier-config": "^1.1.0",
    "devmoji": "^2.3.0",
    "husky": "^9.1.7",
    "jest-environment-node": "^29.7.0",
    "nx": "21.1.2",
    "prettier": "^2.6.2",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.7.2",
    "verdaccio": "^6.0.5"
  },
  "workspaces": [
    "packages/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  }
}
