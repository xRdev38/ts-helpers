{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,

    "paths": {
      "@xrdev_38/ts-utils": ["packages/ts-utils/src/index.ts"],
      "@xrdev_38/ts-functions": ["packages/ts-functions/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "tmp"],
  "display": "Recommended"
}
