{
  "name": "@xrdev_38/ts-utils",
  "version": "0.0.1",
  "description": "snippets and helpers for typescript",
  "keywords": [
    "helpers",
    "typescript",
    "snippets",
    "functions",
    "mixins"
  ],
  "author": "@xrdev_38",
  "license": "ISC",
  "main": "src/index.ts",
  "directories": {
    "src": "src"
  },
  "files": [
    "src/index.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "lint": "npx eslint \"src/**/*.{js,ts,tsx}\"",
    "lint:fix": "npx eslint \"src/**/*.{js,ts,tsx}\" --fix",
    "test": "jest --maxWorkers=50%",
    "test:watch": "jest --watch --maxWorkers=25%",
    "test:ci": "jest --runInBand",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "^17.1.3",
    "@types/jest": "^29.4.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "6.9.1",
    "@typescript-eslint/parser": "6.9.1",
    "eslint": "8.46.0",
    "eslint-config-prettier": "9.0.0",
    "jest": "^29.4.1",
    "jest-environment-jsdom": "^29.4.1",
    "jest-environment-node": "^29.4.1",
    "ts-node": "10.9.1",
    "typedoc": "^0.25.4",
    "typedoc-plugin-markdown": "^3.17.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "inversify": "^6.0.2",
    "tslib": "^2.6.2"
  }
}
